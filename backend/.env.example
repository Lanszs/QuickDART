# Copy this file to .env and fill in real values for local dev.
# In production (Render), set these in the service Environment settings instead.

# Postgres connection string (Supabase pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Supabase project URL and SERVICE ROLE key (NOT the anon key)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=eyJhbGciOi...your-service-role-key

# Storage bucket name for uploaded reports (created automatically on first boot)
SUPABASE_STORAGE_BUCKET=quickdart-uploads

# Production-only: port the server listens on (Render injects $PORT automatically)
# PORT=5000

# Production-only: comma-separated list of allowed frontend origins.
# Default '*' is fine for dev; in prod set this to your Vercel URL,
# e.g. "https://quickdart.vercel.app"
# FRONTEND_ORIGIN=*

# Set to "false" in production to disable Flask debug mode
# FLASK_DEBUG=true
