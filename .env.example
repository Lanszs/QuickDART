# Frontend (Create React App) environment.
# Set these in Vercel: Project Settings → Environment Variables.
# CRA requires the REACT_APP_ prefix to expose values to the browser.

# Backend API origin. After your Render service is live, paste its URL here.
# Example: https://quickdart-backend.onrender.com
REACT_APP_API_URL=https://YOUR-RENDER-BACKEND.onrender.com

# (Optional) Set to "true" to disable CRA's source-map generation in CI builds
# GENERATE_SOURCEMAP=false
